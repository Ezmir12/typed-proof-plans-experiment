# Copy to .env for local development. .env is gitignored — never commit secrets.
# These mirror config.toml. Precedence: exported vars > .env > config.toml.

# --- LLM ---
# Required only for live extraction/elaboration/drafting calls.
TPPS_LLM_API_KEY=
# Optional overrides (defaults shown):
#TPPS_LLM_PROVIDER=openai-compatible
#TPPS_LLM_MODEL=gpt-4o-mini
#TPPS_LLM_BASE_URL=https://api.openai.com/v1
#TPPS_LLM_TIMEOUT_S=60.0
#TPPS_LLM_MAX_RETRIES=2
# Name of the variable holding the key (rarely needs changing):
#TPPS_LLM_API_KEY_ENV=TPPS_LLM_API_KEY

# --- Kernel (all optional; empty endpoint = in-process mock) ---
#TPPS_KERNEL_SYSTEM=lean4+mathlib
#TPPS_KERNEL_ENV_HASH=mock-env-hash-0000
#TPPS_KERNEL_ENDPOINT=

# --- Store (all optional) ---
#TPPS_STORE_OWNER=tpps-prototype
#TPPS_STORE_BACKEND=mock

# --- App (optional) ---
#TPPS_LOG_LEVEL=INFO
